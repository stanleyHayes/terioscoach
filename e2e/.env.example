# Copy to .env and fill in. Never point this at production — the suite
# writes bookings and takes payments, and refuses to start against
# terioscoach.com for that reason.

# The four deployments under test. Preview URLs are the intended target.
E2E_WEB_URL=https://terios-web-git-main.vercel.app
E2E_PORTAL_URL=https://terios-portal-git-main.vercel.app
E2E_ADMIN_URL=https://terios-admin-git-main.vercel.app
E2E_API_URL=https://terios-api-staging.onrender.com

# A seeded practitioner account on that deployment. Not a real one.
E2E_PRACTITIONER_EMAIL=e2e-practitioner@terios-test.invalid
E2E_PRACTITIONER_PASSWORD=

# Authorises the test-only seed routes (a session starting now, for the
# video spec). Must match the API's TESTING_SEED_TOKEN; the API mounts the
# route only when that is set outside production. Leave blank and those
# specs skip rather than fail.
E2E_SEED_TOKEN=

# Set to 1 only on a deployment with TURN credentials configured (CX-02).
# With STUN alone the video spec passes on a LAN and lies about the rest.
E2E_EXPECT_TURN=
