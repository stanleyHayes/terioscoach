# Terios API — local development environment
# Copy to api/.env and fill in. NEVER commit real values.
# In production these live in the Render dashboard env groups (see render.yaml).

APP_ENV=development
PORT=8080

# MongoDB Atlas — Database → Connect → Drivers → connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=terios

# Auth — generate strong random values locally (openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM=Terios Wellness Spa <no-reply@terioswellness.com>

# Cloudinary — https://console.cloudinary.com/ (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack — https://dashboard.paystack.com/#/settings/developers (test keys for dev)
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...

# TURN — Cloudflare Calls (https://dash.cloudflare.com/ → Calls → TURN keys)
TURN_KEY_ID=
TURN_API_TOKEN=

# Comma-separated origins allowed to call the API (both Vercel apps + localhost)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
