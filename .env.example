# Terios API — environment template
#
# ⚠ THIS FILE IS TRACKED BY GIT. It is the only .env* file that is.
#   Put NOTHING real in it — no keys, no tokens, no connection strings.
#   Real values belong in api/.env (local) or api/.env.production
#   (assembly for Render), both of which are git-ignored.
#
# Copy to api/.env and fill in. In production these are entered in the
# Render dashboard; render.yaml declares every one of them.

# ---- Runtime ----
APP_ENV=development
PORT=8080
# Reverse proxies in front of the API. 0 locally, 1 on Render.
TRUSTED_PROXY_HOPS=0
DEFAULT_TIMEZONE=Africa/Accra

# ---- Origins ----
# Empty means no browser origin is permitted: both apps fail every request
# while the API itself looks perfectly healthy.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
PORTAL_URL=http://localhost:3000/portal
DASHBOARD_URL=http://localhost:3001

# ---- Database ----
# Atlas → Database → Connect → Drivers. Substitute the real user and
# password; the angle brackets are placeholders, not syntax.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=terios

# ---- Sessions ----
# openssl rand -base64 48   (two different values)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ---- Brute-force protection ----
AUTH_RATE_LIMIT=0
AUTH_RATE_LIMIT_WINDOW=1m
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=15m
LOGIN_LOCKOUT_COOLDOWN=15m

# ---- Email — https://resend.com/api-keys ----
RESEND_API_KEY=
RESEND_FROM=Terios Wellness Spa <no-reply@terioswellness.com>
PRACTICE_EMAIL=
REMINDER_LEAD=24h
NOTIFICATION_POLL_INTERVAL=60s

# ---- Media — https://console.cloudinary.com/ (Dashboard → API Keys) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DOCUMENT_URL_TTL=10m

# ---- Payments — provider selected by PAYMENT_PROVIDER ----
# paystack (default): dashboard.paystack.com → Settings → API Keys
# stripe: dashboard.stripe.com → API keys + Webhooks (signing secret)
# Test keys for development. A live key here takes real money.
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Video — dash.cloudflare.com → Realtime → TURN Keys ----
# Creating a key yields exactly these two values. They are a long-term
# secret held server-side and exchanged for short-lived credentials per
# session — there is no static TURN username or password.
ROOM_OPEN_BEFORE=10m
ROOM_CLOSE_AFTER=15m
STUN_URLS=stun:stun.cloudflare.com:3478
TURN_KEY_ID=
TURN_API_TOKEN=

# ---- Testing — e2e seed routes ----
# Authorizes POST /v1/testing/sessions, which the Playwright suite uses to
# seed a session starting now. The route exists only when this is set AND
# APP_ENV is not production. NEVER set this in production.
# The e2e suite's E2E_SEED_TOKEN must hold the same value.
TESTING_SEED_TOKEN=
